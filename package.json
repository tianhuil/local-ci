{
	"name": "local-ci",
	"version": "0.2.2",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"local-ci": "bin/local-ci.js"
	},
	"files": [
		"bin",
		"dist"
	],
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
		"test": "vitest run",
		"test:e2e": "pnpm build && LOCAL_CI_E2E=1 vitest run tests/github.e2e.test.ts",
		"release": "node scripts/release.mts",
		"verify": "pnpm lint && pnpm typecheck && pnpm build && vitest run"
	},
	"dependencies": {
		"picomatch": "^4.0.7",
		"yaml": "^2.6.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^24.19.2",
		"commander": "^15.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.2",
		"typescript": "^5.7.2",
		"vitest": "^5.1.1"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome"
		]
	}
}
