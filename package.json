{
	"name": "local-ci",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.15.0",
	"bin": {
		"local-ci": "bin/local-ci.js"
	},
	"files": ["bin", "dist"],
	"scripts": {
		"lint": "biome check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:e2e": "pnpm build && LOCAL_CI_E2E=1 vitest run tests/github.e2e.test.ts",
		"build": "tsc",
		"release": "node scripts/release.mts",
		"verify": "pnpm lint && pnpm typecheck && pnpm build && vitest run"
	},
	"dependencies": {
		"p-map": "^7.0.2",
		"yaml": "^2.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.10.2",
		"commander": "^15.1.0",
		"typescript": "^5.7.2",
		"vitest": "^4.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome"]
	}
}
